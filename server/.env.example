# Copy to .env (never commit .env). The server reads real environment variables.
NODE_ENV=development
PORT=8787
# Comma-separated list of websites allowed to call this API from a browser
CORS_ORIGINS=http://localhost:5173
# Max requests per IP per window (window in ms)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Set true when the host puts a proxy in front (Render, Fly, Railway) so we see the real client IP
TRUST_PROXY=false
LOG_LEVEL=info
# JSON maps are filled from P1's verified record IDs and NASA feed identifiers.
HORIZONS_TARGETS={}
DSN_ROBOT_MAP={}
# Optional override for the committed dated JPL fallback snapshot.
# DISTANCE_SNAPSHOT_FILE=
